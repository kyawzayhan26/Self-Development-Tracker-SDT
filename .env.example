# ============================================================
# SDT V2 - Environment Configuration Example
# ============================================================

# Server
PORT=4000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# SQL Server
# Temporary during V1 -> V2 database migration.
# These variables will be removed once migration to Supabase is complete.
DB_SERVER=localhost
DB_PORT=1433
DB_USER=your_database_username
DB_PASSWORD=your_database_password
DB_DATABASE=SDT